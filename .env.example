PORT=3015
# Endereço completo, com o caminho público e sem barra no final.
PUBLIC_URL=http://localhost:3015
# Client ID OAuth de aplicativo Web. Não é necessário Client Secret.
GOOGLE_CLIENT_ID=
# Separar por vírgulas. Somente estas contas podem consultar/exportar resultados.
ADMIN_EMAILS=
DATA_DIR=./data
